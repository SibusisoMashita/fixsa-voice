{
  "name": "fixsa-voice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FixSA Voice — a civic service-delivery voice agent demo for the AssemblyAI Voice Agent Hackathon.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cpanel": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile-360 --project=mobile-390",
    "test:voice:live": "tsx scripts/voice-live-eval.ts",
    "test:voice:audition": "tsx scripts/voice-live-eval.ts --audition",
    "seed": "tsx scripts/seed.ts",
    "reset": "tsx scripts/reset-demo.ts",
    "audit": "npm audit --audit-level=high",
    "audit:api": "cd api && composer audit",
    "test:api": "cd api && php artisan test",
    "format:api:check": "cd api && vendor/bin/pint --test",
    "verify": "npm run lint && npm run typecheck && npm test && npm run format:api:check && npm run test:api && npm run build:cpanel"
  },
  "dependencies": {
    "clsx": "latest",
    "leaflet": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-leaflet": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/leaflet": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitest/coverage-v8": "latest",
    "eslint": "^9.39.5",
    "eslint-config-next": "latest",
    "jsdom": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
