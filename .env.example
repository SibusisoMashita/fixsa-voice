# Omit this value for deterministic browser-local mode. Set it to the exact
# Laravel API origin for MariaDB persistence and real voice token minting.
NEXT_PUBLIC_FIXSA_API_BASE_URL=http://localhost:8000

# Optional stored Voice Agent ID. If omitted, FixSA Voice sends an inline agent
# configuration over the authenticated WebSocket session.
NEXT_PUBLIC_ASSEMBLYAI_AGENT_ID=

# Public deployment origin, used in share and metadata links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ASSEMBLYAI_API_KEY and database credentials belong only in api/.env.
