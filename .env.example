# Demo mode is the safe default. No external requests or paid services are used.
FIXSA_DEMO_MODE=true

# Real Voice Agent mode — server-only secret. Never prefix this with NEXT_PUBLIC_.
ASSEMBLYAI_API_KEY=

# Optional stored Voice Agent ID. If omitted, FixSA Voice sends an inline agent
# configuration over the authenticated WebSocket session.
NEXT_PUBLIC_ASSEMBLYAI_AGENT_ID=

# Public deployment origin, used in share and metadata links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Region is intentionally explicit because emergency guidance and future routing
# must be configured by an authorised operator.
FIXSA_REGION=South Africa
